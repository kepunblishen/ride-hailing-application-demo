// Copy to Secrets.xcconfig (gitignored) for local Mac / device builds:
//   cp ios/Secrets.example.xcconfig ios/Secrets.xcconfig
//
// Codemagic writes the same path from secure env VUUM_GOOGLE_MAPS_API_KEY
// (see root codemagic.yaml → "Inject Maps API key").
//
// Do NOT commit Secrets.xcconfig. Do NOT replace the placeholder in THIS example.
//
// One key unlocks Maps SDK + Places API (New) + Routes API (+ Directions fallback).
// Google Cloud application restriction: iOS apps → bundle ID com.vuum.app
//
// Included by ios/Vuum/Config/Vuum.xcconfig → substitutes Info.plist
// $(VUUM_GOOGLE_MAPS_API_KEY) / GMSApiKey at build time.
// Guide: docs/GOOGLE_MAPS_SETUP.md · docs/CODEMAGIC_SETUP.md

VUUM_GOOGLE_MAPS_API_KEY = YOUR_GOOGLE_MAPS_API_KEY
