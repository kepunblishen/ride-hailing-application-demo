// Copy to Secrets.xcconfig (gitignored) for local Mac builds.
// Codemagic writes the same file from secure env VUUM_GOOGLE_MAPS_API_KEY.
// Do not commit real API keys. Do not replace the placeholder in this example file.
//
// One key unlocks Maps SDK + Places API (New) + Routes API.
// Bundle ID for key restriction: com.vuum.app
// Guide: docs/GOOGLE_MAPS_SETUP.md · docs/CODEMAGIC_SETUP.md

VUUM_GOOGLE_MAPS_API_KEY = YOUR_GOOGLE_MAPS_API_KEY
