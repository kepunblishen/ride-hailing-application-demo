<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Vuum</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>googlechromes</string>
		<string>comgooglemaps</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Vuum uses your location to find your pickup point and show nearby drivers.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Vuum can keep using your location during a trip so trusted contacts can follow your ride when you share trip status.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Safety recording is available only during an active trip. Audio stays on this device unless you keep it for an incident report, and your driver is notified while recording is on.</string>
	<key>NSCameraUsageDescription</key>
	<string>Vuum uses the camera for profile photos and optional safety features.</string>
	<key>NSMotionUsageDescription</key>
	<string>Vuum uses motion data to improve pickup accuracy and understand how you are traveling.</string>
	<key>VUUM_GOOGLE_MAPS_API_KEY</key>
	<string>$(VUUM_GOOGLE_MAPS_API_KEY)</string>
	<key>GMSApiKey</key>
	<string>$(VUUM_GOOGLE_MAPS_API_KEY)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
